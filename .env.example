# Copy to .env. Never commit .env.
# auto picks cuda when an NVIDIA GPU is present, else cpu. Use remote to call a hosted GPU API.
S2S_BACKEND=auto
S2S_REMOTE_URL=
S2S_ACCESS_CODE=
# Where model weights are downloaded. Keep it out of git.
S2S_WEIGHTS_DIR=weights
# Only needed for gated models. The default path does not use any.
HF_TOKEN=
