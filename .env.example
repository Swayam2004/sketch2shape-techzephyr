# Copy to .env. Never commit .env.
# auto picks cuda when an NVIDIA GPU is present, otherwise cpu. Force one with cuda or cpu.
S2S_BACKEND=auto
# Server settings. Leave S2S_ACCESS_CODE empty to run without an access code.
S2S_ACCESS_CODE=
# The UI talks to this API. Empty means the UI uses its built-in stub.
S2S_API_URL=
# Where model weights are downloaded. Keep it out of git.
S2S_WEIGHTS_DIR=weights
# Only needed for gated models. The default path does not use any.
HF_TOKEN=
